{
  "name": "take-home",
  "author": "Skyler Vautier",
  "version": "0000.000.01",
  "description": "Vite Starter & TypeScript",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon --watch api --ext js,ts --exec \"node api/index.js\"",
    "test": "vitest run",
    "dev": "concurrently -k -n \"VITE,API\" -c \"magenta,cyan\" \"npm:dev:client\" \"npm:dev:server\"",
    "build": "vite build && tsc",
    "start": "NODE_ENV=production node api/index.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" && tsc",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "nuke": "rm -rf node_modules dist build yarn.lock",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "serve": "vite preview"
  },
  "engines": {
    "node": "20.x"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.1.1",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/nunito-sans": "^5.1.1",
    "@fontsource-variable/public-sans": "^5.1.2",
    "@fontsource/barlow": "^5.1.1",
    "@hookform/resolvers": "^3.9.1",
    "@iconify/react": "^5.1.0",
    "@mui/material": "^6.3.0",
    "@playwright/test": "^1.52.0",
    "@tanstack/react-query": "^5.74.7",
    "@types/express": "^5.0.1",
    "autosuggest-highlight": "^3.3.4",
    "cors": "^2.8.5",
    "es-toolkit": "^1.31.0",
    "express": "^5.1.0",
    "framer-motion": "^11.15.0",
    "minimal-shared": "^1.0.5",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.1.1",
    "simplebar-react": "^3.3.0",
    "stylis": "^4.3.4",
    "stylis-plugin-rtl": "^2.1.1",
    "vitest": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/autosuggest-highlight": "^3.2.3",
    "@types/node": "^22.10.3",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^4.4.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "nodemon": "^3.1.10",
    "playwright": "^1.52.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.6",
    "vite-plugin-checker": "^0.8.0"
  }
}
